.page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
}

/* ── 顶栏 ── */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 4rpx;
}

.topbar-btn {
  width: 160rpx;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.topbar-icon {
  font-size: 40rpx;
  line-height: 1.1;
  color: inherit;
}

.topbar-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 2rpx;
}


.hover {
  opacity: 0.5;
}

/* ── 歌曲标题 ── */
.song-title {
  text-align: center;
  font-size: 26rpx;
  padding: 4rpx 96rpx 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── 歌词主体 ── */
.lyrics {
  flex: 1;
  height: 0; /* 配合 flex 让 scroll-view 撑满剩余空间 */
}

.lyrics-inner {
  padding: 24rpx 48rpx 40rpx;
}

/* 方案 A：每句三行居中。普通话 + 中文谐音同字号同字距 → 汉字等宽，逐字对齐 */
.line-block {
  margin-bottom: 44rpx;
  text-align: center;
}

.line-jp {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.line-md {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

.line-hp {
  font-size: 40rpx;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

.lyrics-end {
  text-align: center;
  font-size: 24rpx;
  opacity: 0.5;
  padding: 20rpx 0 40rpx;
}

/* ── 底栏 ── */
.bottombar {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 48rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.bottom-btn {
  font-size: 26rpx;
  opacity: 0.85;
}

/* ── 主题弹层 ── */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.theme-panel {
  width: 100%;
  background: #1c1c1e;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.theme-panel-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 28rpx;
}

.theme-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.theme-card {
  width: 31%;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.theme-swatch {
  width: 100%;
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  border: 2rpx solid transparent;
}

.theme-card.active .theme-swatch {
  border-color: #4a90d9;
  box-shadow: 0 0 12rpx rgba(74, 144, 217, 0.8);
}

.theme-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #cccccc;
}

.theme-close {
  text-align: center;
  font-size: 26rpx;
  padding: 20rpx 0 8rpx;
}

/* ── 最近歌词弹层 ── */
.recent-panel {
  width: 100%;
  max-height: 70vh;
  background: #1c1c1e;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.recent-list {
  overflow-y: auto;
  flex: 1;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #2c2c2e;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-main {
  flex: 1;
  overflow: hidden;
}

.recent-title {
  font-size: 30rpx;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recent-artist {
  font-size: 24rpx;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recent-cur {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid currentcolor;
  border-radius: 8rpx;
}
