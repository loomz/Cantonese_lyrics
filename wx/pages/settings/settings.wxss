.page {
  min-height: 100vh;
  background: #000000;
  padding: 32rpx;
  box-sizing: border-box;
}

.form {
  background: #1c1c1e;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #2c2c2e;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  color: #888888;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radio {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.input {
  background: #2c2c2e;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #ffffff;
}

.ph {
  color: #666666;
}

.preset-row {
  display: flex;
  gap: 16rpx;
  margin: 32rpx 0;
}

.save-btn {
  background: #4a90d9;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.test-btn {
  background: #2c2c2e;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.test-result {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #aaaaaa;
}

.tips {
  margin-top: 40rpx;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.8;
}

.sub-hint {
  color: #666666;
  font-size: 22rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}

.tone-switch {
  transform: scale(0.9);
}

.glm-note {
  color: #ffffff;
  font-size: 28rpx;
}
